# Normalizacion de finales de linea
* text=auto

# Ejecutables y scripts: siempre LF dentro del repo y del checkout
*.sh text eol=lf
*.sh text eol=lf
Makefile text eol=lf
*.gsh text eol=lf
*.ksh text eol=lf
docker-entrypoint*.sh text eol=lf

# Archivos ASCII/UTF-8 de configuracion
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binarios e imagenes: nunca tocar
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.svg binary
*.ico binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary
*.pdf binary