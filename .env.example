# ---------- PostgreSQL ----------
POSTGRES_DB=certichain
POSTGRES_USER=certichain
POSTGRES_PASSWORD=certichain_dev_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Backend Spring Boot ----------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=certichain-bdp-secret-key-debe-cambiarse-en-produccion-2026
JWT_EXPIRATION_MS=86400000

# ---------- Frontend Angular ----------
ANGULAR_BUILD_MODE=production

# ---------- OCR (Tesseract) ----------
OCR_PORT=8090
OCR_LANG=spa

# ---------- Hyperledger Fabric ----------
FABRIC_CHANNEL=certchain
FABRIC_CHAINCODE=certchain
FABRIC_ORG=Org1
FABRIC_PEER=peer0.org1.example.com

# ---------- Infra ----------
COMPOSE_PROJECT_NAME=certichain
